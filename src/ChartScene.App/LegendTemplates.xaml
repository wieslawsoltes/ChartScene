<ResourceDictionary
    x:Class="ChartScene.App.LegendTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charting="using:ChartScene.Charting">
  <DataTemplate x:Key="LegendRow" x:DataType="charting:ChartLegendEntry">
    <Border Padding="6,2" BorderThickness="0,0,0,1" BorderBrush="#50718096">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox IsChecked="{x:Bind IsVisible, Mode=TwoWay}" Content="{x:Bind SeriesName, Mode=OneWay}" MinHeight="28" />
        <TextBlock Text="CUSTOM" FontSize="9" Foreground="#58BCCF" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="LegendMarker">
    <Border Width="32" Height="12" Background="#E9A85B" CornerRadius="6" />
  </DataTemplate>
</ResourceDictionary>
