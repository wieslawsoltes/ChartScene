<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <UnoFeatures>SkiaRenderer;GLCanvas;</UnoFeatures>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Reusable Uno chart surfaces, legends, overview navigation and chart editors.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ChartScene.Interaction/ChartScene.Interaction.csproj" />
    <ProjectReference Include="../ChartScene.Rendering.Skia/ChartScene.Rendering.Skia.csproj" />
  </ItemGroup>
</Project>
